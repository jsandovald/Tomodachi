<Window x:Class="TomodachiCoffee.View.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:TomodachiCoffee.UserControls"
        xmlns:vm="clr-namespace:TomodachiCoffee.Models"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Height="760" Width="1200" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVis" />
    </Window.Resources>

    <Border CornerRadius="25" Background="#002147" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--Left Menu-->
            <Border Grid.RowSpan="3" Background="#FFD700" CornerRadius="25 0 0 25">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <!--Ellipses-->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 30 0 40">
                            <Ellipse Width="8" Height="8" Fill="#eb1700"/>
                            <Ellipse Width="8" Height="8" Fill="#009d00" Margin="7 0"/>
                            <Ellipse Width="8" Height="8" Fill="#002147"/>
                        </StackPanel>
                        
                        <!--Menu Buttons-->
                        <uc:MenuButton Icon="HomeVariant" Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                        <uc:MenuButton Icon="Finance" Command="{Binding NavigateCommand}" CommandParameter="Finance"/>
                        <uc:MenuButton Icon="CommentMultipleOutline" Command="{Binding NavigateCommand}" CommandParameter="Messages"/>
                        <uc:MenuButton Icon="AccountSearchOutline" Command="{Binding NavigateCommand}" CommandParameter="Search"/>
                        <uc:MenuButton Icon="BookSyncOutline" Command="{Binding NavigateCommand}" CommandParameter="Library"/>
                        <uc:MenuButton Icon="AlertCircleCheckOutline" Command="{Binding NavigateCommand}" CommandParameter="Alerts"/>
                        <uc:MenuButton Icon="CogOutline" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                        
                    </StackPanel>
                    <uc:MenuButton Icon="Power" Command="{Binding LogoutCommand}" VerticalAlignment="Bottom" Margin="0 0 0 15"/>
                </Grid>
            </Border>
            
            <!--Top Menu-->
            <Grid Grid.Column="1" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                
                <!--Search Textbox-->
                <Grid>
                    <TextBlock Margin="40 0 15 0" VerticalAlignment="Center" Foreground="#9ea4ad" Panel.ZIndex="1" 
                               IsHitTestVisible="False" Text="Buscar ..."
                               Visibility="{Binding ElementName=textBox, Path=Text.IsEmpty, Converter={StaticResource boolToVis}}" />
                    
                    <TextBox x:Name="textBox" Style="{StaticResource searchTextBox}" />

                    <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" Foreground="#9ea4ad" Margin="15 0 0 0" HorizontalAlignment="Left" />
                </Grid>

                <!--Button-->
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20 0 0 0">
                    <Button Style="{StaticResource topMenuButton}">
                        <Icon:PackIconMaterial Kind="Bell" Style="{StaticResource topMenuButtonIcon}" />
                    </Button>

                    <Button Style="{StaticResource topMenuButton}">
                        <Icon:PackIconMaterial Kind="Bookmark" Style="{StaticResource topMenuButtonIcon}" />
                    </Button>

                    <Button Style="{StaticResource topMenuButton}" Background="#1e2e44">
                        <Icon:PackIconMaterial Kind="Account" Style="{StaticResource topMenuButtonIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido inyectado -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" />

        </Grid>
    </Border>
</Window>
