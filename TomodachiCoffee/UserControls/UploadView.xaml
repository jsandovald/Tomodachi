<UserControl x:Class="TomodachiCoffee.UserControls.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:TomodachiCoffee.UserControls"
             xmlns:vm="clr-namespace:TomodachiCoffee.Models"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <StackPanel>
        <Button Content="Seleccionar archivo Excel" 
                    Command="{Binding SeleccionarArchivoCommand}" 
                    Width="200" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding RutaArchivo}" 
                       TextWrapping="Wrap" 
                       FontStyle="Italic"
                       Foreground="Gray"/>

        <Button Content="Cargar archivo" 
                    Command="{Binding CargarArchivoCommand}" 
                    Width="200" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <Button Content="Ver Reporte" Command="{Binding CargarReporteCommand}" Width="120" Margin="0,10"/>
        <DataGrid ItemsSource="{Binding ReporteItems}" AutoGenerateColumns="False" Height="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" />
                <DataGridTextColumn Header="Medio de Pago" Binding="{Binding MedioPago}" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
